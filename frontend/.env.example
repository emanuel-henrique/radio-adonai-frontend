# IMPORTANTE: variáveis NEXT_PUBLIC_* são lidas em tempo de BUILD, não de
# execução. O Next.js grava o valor dentro do bundle do navegador. Alterar a
# variável na Vercel só surte efeito no próximo deploy — e o .env.local daqui
# NÃO é publicado, então o valor padrão acaba embutido no bundle.

# URL pública da API do backend
# Em desenvolvimento, deixe http://localhost:3001 (padrão)
# NEXT_PUBLIC_API_URL=https://sua-api.exemplo.com

# Client ID do Google OAuth (usado pelo Google Identity Services no login)
# Crie em https://console.cloud.google.com/apis/credentials
# As origens JS autorizadas devem incluir http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Proxy do áudio da rádio. É a fonte principal porque o Shoutcast serve AAC com
# o Content-Type "audio/aacp", que os navegadores rejeitam.
#
# Em produção aponte para o Cloudflare Worker do diretório ../radio-proxy.
# Ele existe separado do backend porque funções serverless da Vercel cortam o
# stream em 300s (Hobby), e uma rádio precisa ficar no ar por horas.
# NEXT_PUBLIC_RADIO_PROXY_URL=https://radio-adonai-proxy.<seu-subdomain>.workers.dev
#
# O padrão é <NEXT_PUBLIC_API_URL>/radio/stream, útil só em desenvolvimento com
# o backend rodando localmente.

# URL direta do Shoutcast, usada apenas como segundo recurso caso o proxy falhe.
# Atenção: enquanto o host responder "audio/aacp", esta URL sempre falha — o
# navegador recusa. Vale a pena pedir ao VoxHD um mount em MP3 para que o
# fallback passe a funcionar de verdade.
# NEXT_PUBLIC_RADIO_STREAM_URL=https://stm.voxhd.com.br:7290

# API de metadados da rádio (música atual, capa, ouvintes, status)
# NEXT_PUBLIC_RADIO_METADATA_URL=https://voxhd.com.br/api-json/NzI5MCsx
