# URL pública da API do backend
# Em desenvolvimento, deixe http://localhost:3001 (padrão)
# NEXT_PUBLIC_API_URL=https://sua-api.exemplo.com

# Client ID do Google OAuth (usado pelo Google Identity Services no login)
# Crie em https://console.cloud.google.com/apis/credentials
# As origens JS autorizadas devem incluir http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Proxy do áudio da rádio (backend). É a fonte principal porque o Shoutcast
# serve AAC com o Content-Type "audio/aacp", que os navegadores rejeitam.
# O padrão é <NEXT_PUBLIC_API_URL>/radio/stream — normalmente não é preciso definir.
# NEXT_PUBLIC_RADIO_PROXY_URL=https://sua-api.exemplo.com/radio/stream

# URL direta do Shoutcast, usada apenas como segundo recurso caso o proxy falhe.
# NEXT_PUBLIC_RADIO_STREAM_URL=https://stm.voxhd.com.br:7290

# API de metadados da rádio (música atual, capa, ouvintes, status)
# NEXT_PUBLIC_RADIO_METADATA_URL=https://voxhd.com.br/api-json/NzI5MCsx
